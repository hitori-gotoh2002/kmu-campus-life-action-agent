# === 실행 모드 ===
# true: 가짜 데이터 시연 / false: 실제 수집·LLM·노션·텔레그램
DEMO_MODE=true
# approval(단건 승인) / digest(분야별 추천서)
DELIVERY_MODE=approval

# === LLM (OpenAI) ===
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRANSCRIPT_MODEL=gpt-4o
# (Gemini 사용 시)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === Notion (캘린더 + 포트폴리오만) ===
# 나머지(프로필·이력·설정·졸업데이터)는 로컬 백엔드(data/agent.db)에 자동 저장
NOTION_API_KEY=
NOTION_CALENDAR_DB_ID=        # 내 캘린더(회의·모임 등 실제 일정) ; setup_notion.py 가 자동 생성
NOTION_PORTFOLIO_PAGE_ID=     # 포트폴리오 페이지(본인이 작성)

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 동작 옵션 ===
DEMO_APPROVE=yes              # 데모 승인 시뮬레이션
PIPELINE_DRY_RUN=false        # 승인/실행 생략(점검용)
MAX_DETAIL_PER_SOURCE=8       # 소스당 상세 진입 수
LINKAREER_PAGE_SIZE=24        # 링커리어 소스당 최신 조회 수
SOURCE_FOCUS_FILTER=true      # AI빅데이터융합경영학과 시연용 키워드 필터
DIGEST_WEEKLY_DAY=월          # 매주 추천 발송 요일
DIGEST_HOUR=8
DIGEST_MINUTE=0
