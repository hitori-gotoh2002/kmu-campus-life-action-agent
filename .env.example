# === 실행 모드 ===
# true: 가짜 데이터 시연 / false: 실제 수집·LLM·노션·텔레그램
DEMO_MODE=true
# approval(단건 승인) / digest(분야별 추천서)
DELIVERY_MODE=approval

# === LLM (OpenAI) ===
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRANSCRIPT_MODEL=gpt-4o
# (Gemini 사용 시)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === Notion ===
NOTION_API_KEY=
NOTION_SCHEDULE_DB_ID=        # (구) 일정 DB
NOTION_KANBAN_DB_ID=          # 칸반(승인 활동)
NOTION_HISTORY_DB_ID=         # 추천 이력(중복방지·피드백·웹)
NOTION_PROFILE_DB_ID=         # 내 프로필(포트폴리오 동기화)
NOTION_PREFS_DB_ID=           # 추천 설정(분야별 주기)
NOTION_PORTFOLIO_PAGE_ID=     # 포트폴리오 페이지
NOTION_CALENDAR_DB_ID=        # 내 캘린더(시간표→가용시간)
NOTION_GRAD_REQ_DB_ID=        # 졸업요건(기준학점)
NOTION_GRAD_HISTORY_DB_ID=    # 이수내역

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 동작 옵션 ===
DEMO_APPROVE=yes              # 데모 승인 시뮬레이션
PIPELINE_DRY_RUN=false        # 승인/실행 생략(점검용)
MAX_DETAIL_PER_SOURCE=8       # 소스당 상세 진입 수
LINKAREER_PAGE_SIZE=10
DIGEST_WEEKLY_DAY=월          # 매주 추천 발송 요일
DIGEST_HOUR=8
DIGEST_MINUTE=0
